{
  "name": "jwt-auth",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "postinstall": "node scripts/link-workspace-packages.mjs"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "prettier": "^3.7.4",
    "turbo": "^2.10.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "overrides": {
    "@types/node": "^22.15.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {}
}