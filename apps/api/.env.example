# Runtime — "development" enables plain-HTTP cookies and the plain cookie
# name; anything else is treated as production (Secure + __Host- cookies).
NODE_ENV=development
PORT=8000

# Database — a Postgres/Neon connection string.
DATABASE_URL=postgresql://user:password@host.example.com:5432/dbname

# The web app origin, used by CORS when the web app calls this API directly.
# (Not needed when the web app proxies /api/* here — see apps/web/next.config.js.)
CLIENT_URL=http://localhost:3000

# Set only when running behind a reverse proxy, so rate limiting sees real
# client IPs instead of the proxy's. Accepts a hop count, "true", or e.g.
# "loopback" — anything express' "trust proxy" setting accepts.
# TRUST_PROXY=1

# JWT secrets — replace with long random values in production
# (e.g. `openssl rand -hex 32`). Use DIFFERENT values for each.
ACCESS_TOKEN_SECRET=replace-with-long-random-value
REFRESH_SECRET=replace-with-a-different-long-random-value

# Token lifetimes. Allowed values: 15m, 30m, 1h, 6h, 12h, 1d, 7d, 30d.
# The refresh cookie and DB row always expire together with the refresh JWT.
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d
