# API proxy target: where the web app's /api/* rewrite forwards to.
# Defaults to http://localhost:8000 when unset.
# API_PROXY_URL=http://localhost:8000

# Set ONLY to bypass the built-in /api proxy and call the API directly from
# the browser (cross-origin; the API must allow this origin in CLIENT_URL).
# NEXT_PUBLIC_API_URL=http://localhost:8000
